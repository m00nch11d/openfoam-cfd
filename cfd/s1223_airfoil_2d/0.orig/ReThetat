FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      ReThetat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "<case>/caseParameters"

dimensions      [0 0 0 0 0 0 0];

internalField   uniform $ReThetatInf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    farfield
    {
        type            inletOutlet;
        inletValue      uniform $ReThetatInf;
        value           uniform $ReThetatInf;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform $ReThetatInf;
        value           uniform $ReThetatInf;
    }
    airfoil
    {
        type            zeroGradient;
    }
}

