FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "<case>/caseParameters"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform $Uinf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    farfield
    {
        type            freestreamVelocity;
        freestreamValue uniform $Uinf;
        value           uniform $Uinf;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform $Uinf;
        value           uniform $Uinf;
    }
    airfoil
    {
        type            noSlip;
    }
}

