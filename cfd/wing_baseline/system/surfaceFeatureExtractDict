FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

wing.stl
{
    extractionMethod    extractFromSurface;

    // Edges whose faces meet at less than this angle are features
    // (leading/trailing edges, blunt TE, tip, flaperon cut-outs)
    includedAngle       150;

    subsetFeatures
    {
        nonManifoldEdges    no;
        openEdges           yes;
    }

    writeObj            no;
}

