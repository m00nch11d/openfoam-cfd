FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "<case>/caseParameters"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $kInf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           uniform $kInf;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform $kInf;
        value           uniform $kInf;
    }
    farfield
    {
        type            inletOutlet;
        inletValue      uniform $kInf;
        value           uniform $kInf;
    }
    symmetry
    {
        type            symmetryPlane;
    }
    wing
    {
        type            kqRWallFunction;
        value           uniform $kInf;
    }
}

